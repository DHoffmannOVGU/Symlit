# Symlit runs without any configuration. Copy to .env only to override defaults.

# PostgreSQL connection. When unset, Symlit uses an embedded PostgreSQL
# (PGlite) stored in SYMLIT_DATA_DIR.
# DATABASE_URL=postgres://symlit:symlit@localhost:5432/symlit
# SYMLIT_DATA_DIR=./data

# Server address. Defaults to 127.0.0.1:5000 (not reachable from other machines).
# HOST=127.0.0.1
# PORT=5000

# Name shown for the local user.
# SYMLIT_USER_NAME=Local user

# Create a demo project when the workspace is empty (default true).
# SYMLIT_SEED_DEMO=true

# Experimental internal views (default false).
# SYMLIT_INTERNAL_VIEWS=false

# Optional AI metamodel assistant (Google Gemini). Bring your own key.
# GEMINI_API_KEY=
# One model, or a comma-separated fallback list:
# GEMINI_MODEL=
